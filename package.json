{
  "name": "biohuman",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Entrenamiento local-first del ecosistema de salud SWAL",
  "scripts": {
    "lint": "biome check .",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:exercises": "node scripts/vendor-exercises.mjs",
    "test:e2e": "playwright test",
    "e2e:ta": "E2E_TELEMETRY_DISABLED=1 e2e run --target local",
    "e2e:ta:live": "E2E_TELEMETRY_DISABLED=1 e2e run e2e-ta/smoke.e2e.ts --target live --exclude-tag mutating"
  },
  "dependencies": {
    "@swal/ui": "^0.2.0",
    "@swal/vault": "^0.2.0",
    "astro": "^7.4.2",
    "idb": "8.0.3",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/svelte": "^9.1.1",
    "@biomejs/biome": "^2.6.4",
    "@e2e-dev/web": "0.14.0",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.5.4",
    "e2e": "0.20.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "svelte": "^5.57.3",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.154.0"
  }
}
