{
  "name": "biohuman",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Entrenamiento local-first del ecosistema de salud SWAL",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:exercises": "node scripts/vendor-exercises.mjs",
    "test:e2e": "playwright test",
    "e2e:ta": "E2E_TELEMETRY_DISABLED=1 e2e run --target local",
    "e2e:ta:live": "E2E_TELEMETRY_DISABLED=1 e2e run e2e-ta/smoke.e2e.ts --target live --exclude-tag mutating"
  },
  "dependencies": {
    "@swal/ui": "^0.2.0",
    "@swal/vault": "^0.2.0",
    "astro": "^7.4.2",
    "idb": "8.0.4",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/svelte": "^9.1.1",
    "@e2e-dev/web": "0.15.3",
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.6.1",
    "e2e": "0.21.3",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "svelte": "^5.57.2",
    "svgo": "^4.0.0",
    "typescript": "^5.9.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  }
}
