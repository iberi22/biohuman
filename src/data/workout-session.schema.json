{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SWAL workout-session v1 \u2014 espejo del borrador 2026-10-02",
  "type": "object",
  "required": [
    "schema",
    "id",
    "subject",
    "createdAt",
    "source",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "swal.health/v1/workout-session"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^subj_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "app",
        "version"
      ],
      "properties": {
        "app": {
          "enum": [
            "training",
            "orionhealth",
            "gos",
            "fize"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    },
    "gosDataset": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "startedAt",
        "endedAt",
        "exercises",
        "energy"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "routineId": {
          "type": "string"
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ref",
              "sets"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^wg:[a-z0-9-]+$"
              },
              "sets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "reps": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "weightKg": {
                      "type": "number",
                      "minimum": 0
                    },
                    "durationS": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "distanceM": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "rpe": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 10
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "reps"
                      ]
                    },
                    {
                      "required": [
                        "durationS"
                      ]
                    },
                    {
                      "required": [
                        "distanceM"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "energy": {
          "type": "object",
          "required": [
            "kcal",
            "method"
          ],
          "properties": {
            "kcal": {
              "type": "number",
              "minimum": 0
            },
            "method": {
              "const": "met-estimate"
            }
          }
        },
        "perceivedEffort": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
