---
import { Toaster } from '@swal/ui';
import themeCss from '@swal/ui/tokens?inline';
interface Props { title?:string; }
const {title='SWAL Training'}=Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content="Tu biblioteca, rutinas y progreso. Entrenamiento privado en tu dispositivo."/><link rel="manifest" href="/manifest.json"/><link rel="icon" href="/favicon.svg"/><meta name="theme-color" content="#FAF9F5"/><script src="/registerSW.js" defer is:inline></script><script is:inline>try{var t=localStorage.getItem('swal-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch{}</script><style is:global set:html={themeCss}/></head><body><a class="skip" href="#main">Ir al contenido</a><slot/><Toaster client:load/></body></html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:var(--swal-bg);background-image:var(--swal-mesh);background-attachment:fixed;color:var(--swal-text);font-family:var(--swal-font);-webkit-font-smoothing:antialiased}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(1.8rem,4vw,2.65rem);font-weight:600;letter-spacing:-.04em;margin-bottom:.5rem}h2{font-size:1.25rem;font-weight:600;letter-spacing:-.02em}h3{font-size:1rem;font-weight:600}a{color:inherit}button,input,select,textarea{font:inherit}button{cursor:pointer}input,select,textarea,button:not(.swal-btn){border:1px solid var(--swal-border-strong);border-radius:var(--swal-radius-sm,8px);background:var(--swal-surface);color:var(--swal-text);min-height:44px;padding:.65rem .8rem}input,select,textarea{width:100%;min-width:0}label{display:grid;gap:.4rem;font-size:.8rem;color:var(--swal-text-secondary)}button:disabled{opacity:.5;cursor:default}:where(a,button,input,select,textarea):focus-visible{outline:2px solid var(--swal-text);outline-offset:3px}.muted{color:var(--swal-text-secondary)}.skip{position:fixed;top:-100px;left:1rem;z-index:100;background:var(--swal-bg);padding:1rem}.skip:focus{top:1rem}.panel{background:var(--swal-surface);backdrop-filter:blur(16px);border:1px solid var(--swal-border);border-radius:var(--swal-radius,12px);padding:1.25rem}.row{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap}.between{justify-content:space-between}.stack{display:grid;gap:1rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}.eyebrow{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--swal-text-secondary);margin-bottom:1rem}.intro{margin-bottom:2rem}.intro p{line-height:1.6;max-width:600px}.number{font-family:var(--swal-font-mono);font-variant-numeric:tabular-nums}.error{padding:1rem;border:1px solid var(--swal-text-secondary);border-radius:8px}small{line-height:1.6}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
</style>
