---
import Layout from '../../layouts/Layout.astro';
import TrainingApp from '../../components/TrainingApp.svelte';
import exercises from '../../data/exercises.json';
export const prerender = true;
export function getStaticPaths(){return exercises.map(e=>({params:{slug:e.slug},props:{name:e.name_es}}));}
const {slug}=Astro.params;
---
<Layout title={`${Astro.props.name} · BioHuman`}><TrainingApp page="detail" slug={slug} client:load /></Layout>
